<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>LanQueue</RootNamespace>
    <AssemblyName>lanq</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lanq</ToolCommandName>
    <PackageId>LanQueue</PackageId>
    <Version>0.0.0-dev</Version>
    <Authors>Jason Wood</Authors>
    <Description>Headless, capability-routed job runner for your own LAN machines: key-only SSH, allowlisted commands, per-job git worktrees.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/jangolath/lanqueue</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/jangolath/lanqueue</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageTags>ssh;build;ci;lan;job-runner;git-worktree</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="all" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LanQueue.Tests" />
  </ItemGroup>
</Project>
