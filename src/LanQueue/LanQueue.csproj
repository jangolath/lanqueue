<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>LanQueue</RootNamespace>
    <AssemblyName>lanq</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lanq</ToolCommandName>
    <PackageId>LanQueue</PackageId>
    <Version>0.0.0-dev</Version>
    <Authors>Jason Wood</Authors>
    <Description>Plug your old PCs back in and give them work. lanq sends builds, tests and coding-agent jobs to spare machines on your LAN over key-only SSH, with allowlisted commands and per-job git worktrees.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/jangolath/lanqueue/releases</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/jangolath/lanqueue</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/jangolath/lanqueue</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageTags>dotnet-tool;ssh;build;ci;lan;distributed;homelab;ai-agents;claude-code;test-runner</PackageTags>
  </PropertyGroup>
  <!--
    The release's pack passes -p:LanqReleaseNotesFile=<file> (written from CHANGELOG.md by scripts/release-notes.sh), so the package's
    release notes are that file's text; read from a file because multi-line text does not survive -p:. Otherwise the link above stays.
  -->
  <PropertyGroup Condition="'$(LanqReleaseNotesFile)' != '' And Exists('$(LanqReleaseNotesFile)')">
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText('$(LanqReleaseNotesFile)'))</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <!-- Generates the YAML StaticContext at compile time (no reflection), so the same code path works in the tool and the NativeAOT binary. -->
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" Version="18.1.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="all" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
    <None Include="../../assets/lanqueue-icon.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>
  <!--
    The .NET runtime patch that ships inside the native binaries (ILCompiler) and the trim/AOT analyzers (ILLink), pinned so that builds
    and the committed lock files do not move with whichever SDK patch a machine has. Bump it deliberately (see RELEASING.md).
  -->
  <PropertyGroup>
    <LanqRuntimePackVersion>10.0.15</LanqRuntimePackVersion>
  </PropertyGroup>
  <ItemGroup>
    <KnownILLinkPack Update="Microsoft.NET.ILLink.Tasks" ILLinkPackVersion="$(LanqRuntimePackVersion)" />
    <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler" ILCompilerPackVersion="$(LanqRuntimePackVersion)" />
  </ItemGroup>
  <!--
    NativeAOT single-file binaries for GitHub Releases: only with -p:LanqNative=true on dotnet publish (never build or pack, so the NuGet
    tool stays framework-dependent). Restores against its own lock file covering every release RID.
  -->
  <PropertyGroup Condition="'$(LanqNative)' == 'true'">
    <PublishAot>true</PublishAot>
    <!-- The framework libraries compiled in come from this runtime pack: the same pinned patch as ILCompiler. -->
    <RuntimeFrameworkVersion>$(LanqRuntimePackVersion)</RuntimeFrameworkVersion>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-arm64</RuntimeIdentifiers>
    <NuGetLockFilePath>packages.native.lock.json</NuGetLockFilePath>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <!-- Kept (the default false): framework exception messages such as "Could not find file" are shown to users. -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>
  <Target Name="LanqNativeIsPublishOnly" BeforeTargets="GenerateNuspec;Pack" Condition="'$(LanqNative)' == 'true'">
    <Error Text="LanqNative is for dotnet publish only; the NuGet tool package must stay framework-dependent." />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="LanQueue.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- lanq-makeready (read-only readiness check), byte-identical to its verified release; updated only by scripts/sync-makeready.sh. -->
    <EmbeddedResource Include="Makeready/lanq-makeready.ps1" LogicalName="lanq-makeready.ps1" />
    <EmbeddedResource Include="Makeready/lanq-makeready.sh" LogicalName="lanq-makeready.sh" />
  </ItemGroup>
</Project>
